{
  "name": "Tsurugaoka Quest",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },
  "postCreateCommand": "npm install --global @github/copilot",
  "remoteUser": "root",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "zsh": {
            "path": "/bin/zsh"
          }
        },
        "extensions": [
          "GitHub.vscode-pull-request-github",
          "GitHub.copilot",
          "GitHub.copilot-chat"
        ]
      }
    }
  }
}
